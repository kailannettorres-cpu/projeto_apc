/* ==========================================================
   Professores em Ação — style.css
   Telas: login, painel (conteúdos + exercícios), seleção de
   área específica (diálogo) e página de conteúdo.
   ========================================================== */

@import url("https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700&family=Source+Sans+3:wght@400;600&display=swap");

/* ---------- Tokens ---------- */
:root {
  --fundo: #eceeed;
  --superficie: #f8f9f8;
  --tinta: #15211a;
  --tinta-suave: #4a5850;
  --linha: #c7cfca;

  --verde: #1a6b3c;
  --verde-escuro: #124d2b;
  --verde-claro: #dcebe1;
  --azul: #0b2a9a;

  --fonte-titulo: "Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --fonte-texto: "Source Sans 3", "Segoe UI", system-ui, sans-serif;

  --raio: 8px;
  --altura-topo: 64px;
  --largura-menu: 264px;
  --largura-exercicios: 320px;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-tema="claro"]) {
    --fundo: #101613;
    --superficie: #19211c;
    --tinta: #e6ece8;
    --tinta-suave: #a2afa7;
    --linha: #2c3831;
    --verde: #3fa56a;
    --verde-escuro: #5cc088;
    --verde-claro: #1f3a2a;
    --azul: #8aa0ff;
  }
}

/* ---------- Base ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  height: 100%;
}

body {
  margin: 0;
  min-height: 100%;
  background: var(--fundo);
  color: var(--tinta);
  font-family: var(--fonte-texto);
  font-size: 1.0625rem;
  line-height: 1.6;
}

h1,
h2,
h3 {
  font-family: var(--fonte-titulo);
  line-height: 1.15;
  margin: 0 0 0.5em;
}

a {
  color: var(--azul);
}

:focus-visible {
  outline: 3px solid var(--azul);
  outline-offset: 2px;
}

[hidden] {
  display: none !important;
}

/* ---------- Botões e campos ---------- */
.botao {
  display: inline-block;
  padding: 0.7rem 1.6rem;
  border: 0;
  border-radius: var(--raio);
  background: var(--verde);
  color: #fff;
  font: 600 1rem var(--fonte-texto);
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s;
}

.botao:hover {
  background: var(--verde-escuro);
}

.botao--secundario {
  background: transparent;
  color: var(--verde);
  border: 2px solid var(--verde);
}

.botao--secundario:hover {
  background: var(--verde-claro);
}

.campo {
  display: block;
  margin-bottom: 1.5rem;
}

.campo__rotulo {
  display: block;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--azul);
}

.campo__entrada {
  width: 100%;
  padding: 0.5rem 0;
  border: 0;
  border-bottom: 2px solid var(--verde);
  background: transparent;
  color: var(--tinta);
  font: inherit;
}

.campo__entrada:focus {
  outline: none;
  border-bottom-color: var(--azul);
  box-shadow: 0 2px 0 var(--azul);
}

/* ==========================================================
   TELA 1 — Login
   ========================================================== */
.login {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  align-items: center;
  gap: 3rem;
  padding: 3rem clamp(1.5rem, 6vw, 6rem);
  /* espaço para o "desenho de fundo": grade de pontos */
  background-image: radial-gradient(var(--linha) 1.6px, transparent 1.6px);
  background-size: 22px 22px;
}

.login__boas-vindas h1 {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  color: var(--verde);
  margin-bottom: 0.2em;
}

.login__boas-vindas p {
  font-family: var(--fonte-titulo);
  font-size: clamp(1.4rem, 3vw, 2.2rem);
  color: var(--azul);
  margin: 0;
}

.login__cartao {
  width: 100%;
  max-width: 420px;
  justify-self: center;
  padding: 2.5rem 2rem 2rem;
  background: var(--superficie);
  border: 1px solid var(--linha);
  border-radius: var(--raio);
}

.login__cartao h2 {
  font-size: 1.9rem;
  color: var(--verde);
  margin-bottom: 1.5rem;
}

.login__cartao .botao {
  width: 100%;
  margin-top: 1rem;
}

.login__alternativa {
  margin: 1rem 0 0;
  text-align: center;
  color: var(--tinta-suave);
  font-size: 0.95rem;
}

/* ==========================================================
   TELAS 2, 3 e 4 — Painel
   ========================================================== */
.app {
  min-height: 100vh;
  display: grid;
  grid-template-rows: var(--altura-topo) 1fr;
}

/* ---------- Topo ---------- */
.topo {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 1.5rem;
  background: var(--superficie);
  border-bottom: 2px solid var(--azul);
}

.topo__titulo {
  margin: 0;
  font-size: 1.4rem;
  color: var(--verde);
}

.topo__acoes {
  display: flex;
  gap: 1.5rem;
}

.topo__acoes a {
  font-weight: 600;
  text-decoration: none;
}

.topo__acoes a:hover {
  text-decoration: underline;
}

/* ---------- Corpo em 3 colunas ---------- */
.corpo {
  display: grid;
  grid-template-columns: var(--largura-menu) minmax(0, 1fr) var(--largura-exercicios);
}

/* ---------- Menu lateral: Conteúdos ---------- */
.menu {
  padding: 1.5rem 1rem;
  border-right: 2px solid var(--azul);
  background: var(--superficie);
}

.menu__titulo {
  margin: 0 0 1rem 0.5rem;
  font-size: 1.15rem;
  color: var(--verde);
}

.menu__lista {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.menu__item {
  display: block;
  width: 100%;
  padding: 0.6rem 1rem;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--tinta);
  font: 600 1rem var(--fonte-texto);
  text-align: left;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}

.menu__item::before {
  content: "→";
  margin-right: 0.6rem;
  color: var(--azul);
}

.menu__item:hover {
  background: var(--verde-claro);
}

.menu__item[aria-current="page"] {
  background: var(--verde);
  color: #fff;
}

.menu__item[aria-current="page"]::before {
  color: #fff;
}

/* ---------- Conteúdo principal ---------- */
.conteudo {
  padding: 2rem clamp(1.5rem, 4vw, 3.5rem);
}

.conteudo__titulo {
  display: inline-block;
  margin-bottom: 1.5rem;
  padding: 0.25rem 1.25rem;
  border: 2px solid var(--verde);
  border-radius: 4px;
  font-size: 1.5rem;
  color: var(--verde);
}

.conteudo__texto {
  max-width: 68ch;
}

.conteudo__texto p {
  margin: 0 0 1.1em;
}

.conteudo__texto code {
  padding: 0.1em 0.4em;
  border-radius: 4px;
  background: var(--verde-claro);
  color: var(--verde-escuro);
  font-size: 0.95em;
}

/* ---------- Coluna: Exercícios ---------- */
.exercicios {
  padding: 2rem 1.5rem;
  border-left: 1px solid var(--linha);
}

.exercicios__titulo {
  display: inline-block;
  margin-bottom: 1.25rem;
  padding: 0.2rem 1rem;
  border: 2px solid var(--verde);
  border-radius: 4px;
  font-size: 1.1rem;
  color: var(--verde);
}

.exercicios__lista {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.exercicios__lista a {
  display: block;
  padding: 0.85rem 1rem;
  border: 1px solid var(--linha);
  border-left: 4px solid var(--verde);
  border-radius: var(--raio);
  background: var(--superficie);
  color: var(--tinta);
  text-decoration: none;
  transition: border-color 0.15s, transform 0.15s;
}

.exercicios__lista a:hover {
  border-left-color: var(--azul);
  transform: translateX(2px);
}

/* ==========================================================
   TELA 3 — Diálogo "Área específica"
   ========================================================== */
.dialogo {
  width: min(92vw, 460px);
  padding: 1.75rem;
  border: 1px solid var(--linha);
  border-radius: var(--raio);
  background: var(--superficie);
  color: var(--tinta);
}

.dialogo::backdrop {
  background: rgba(10, 20, 15, 0.45);
}

.dialogo[open] {
  animation: dialogo-entra 0.18s ease-out;
}

@keyframes dialogo-entra {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
}

.dialogo__titulo {
  font-size: 1.3rem;
  color: var(--verde);
}

.dialogo__ajuda {
  margin: 0 0 1.25rem;
  color: var(--tinta-suave);
  font-size: 0.95rem;
}

.dialogo fieldset {
  margin: 0;
  padding: 0;
  border: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem 1.5rem;
}

.opcao {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.35rem 0;
  cursor: pointer;
}

.opcao input {
  width: 1.15rem;
  height: 1.15rem;
  accent-color: var(--verde);
}

.dialogo__acoes {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  margin-top: 1.75rem;
}

/* ==========================================================
   Responsivo
   ========================================================== */
@media (max-width: 1100px) {
  .corpo {
    grid-template-columns: var(--largura-menu) minmax(0, 1fr);
  }

  .exercicios {
    grid-column: 2;
    border-left: 0;
    border-top: 1px solid var(--linha);
  }
}

@media (max-width: 760px) {
  .login {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem 1.25rem;
  }

  .corpo {
    grid-template-columns: 1fr;
  }

  .menu {
    border-right: 0;
    border-bottom: 2px solid var(--azul);
    padding: 1rem;
  }

  .menu__lista {
    flex-direction: row;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .menu__item {
    width: auto;
    white-space: nowrap;
  }

  .exercicios {
    grid-column: 1;
  }

  .dialogo fieldset {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}
